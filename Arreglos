  "Programar no es memorizar, es aprender a pensar paso a paso."
];

function toast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._timer);
  t._timer = setTimeout(()=>t.classList.remove('show'), 2200);
}

function addXp(amount){
  state.xp += amount;
  const newLevel = Math.floor(state.xp / XP_PER_LEVEL) + 1;
  if(newLevel > state.level){
    state.level = newLevel;
    toast(`🎉 ¡Nivel ${state.level} desbloqueado! Sigue así.`);
  } else {
    toast(`+${amount} XP`);
  }
  renderHeader();
}

function renderHeader(){
  document.getElementById('topLevel').textContent = state.level;
  document.getElementById('topXp').textContent = `${state.xp} XP`;
  document.getElementById('homeLevel').textContent = state.level;
  const xpInLevel = state.xp % XP_PER_LEVEL;
  document.getElementById('homeXp').textContent = `${xpInLevel} / ${XP_PER_LEVEL}`;
  document.getElementById('homeDone').textContent = state.completedExercises.size;
  const pct = Math.round((state.completedExercises.size / TOTAL_EXERCISES) * 100);
  document.getElementById('homePct').textContent = pct + '%';
  document.getElementById('homeBar').style.width = pct + '%';

  document.getElementById('pLevel').textContent = state.level;
  document.getElementById('pXp').textContent = state.xp;
  document.getElementById('pDone').textContent = `${state.completedExercises.size}/${TOTAL_EXERCISES}`;
  document.getElementById('pBar').style.width = pct + '%';
  document.getElementById('pBarLabel').textContent = pct + '% completado';
  renderBadges();
  renderPracticeLocks();
}

function renderBadges(){
  const badges = [
    {id:'b1', label:'🔰 Primeros pasos', earned: state.completedExercises.size >= 1},
    {id:'b2', label:'🟢 Nivel básico dominado', earned: state.completedExercises.has('ex1') && state.completedExercises.has('ex2')},
    {id:'b3', label:'🟡 Nivel intermedio dominado', earned: ['ex3','ex4','ex5'].every(x=>state.completedExercises.has(x))},
    {id:'b4', label:'🔴 Nivel avanzado dominado', earned: ['ex6','ex7','ex8'].every(x=>state.completedExercises.has(x))},
    {id:'b5', label:'🃏 Flashcards revisadas', earned: state.fcKnown.size >= 25},
    {id:'b6', label:'🏆 Desafío final superado', earned: state.examBadge !== null},
  ];
  document.getElementById('badgeRow').innerHTML = badges.map(b=>
    `<span class="badge ${b.earned?'earned':''}">${b.label}</span>`).join('');
}

/* =========================================================
   NAVEGACIÓN
========================================================= */
const views = ['home','learn','flash','practice','exam','progress'];
function goto(view){
  views.forEach(v=>{
    document.getElementById('view-'+v).classList.toggle('hidden', v!==view);
  });
  document.querySelectorAll('#mainNav button').forEach(b=>{
    b.classList.toggle('active', b.dataset.view===view);
  });
  window.scrollTo({top:0, behavior:'smooth'});
}
document.getElementById('mainNav').addEventListener('click', e=>{
  const btn = e.target.closest('button[data-view]');
  if(btn) goto(btn.dataset.view);
});
document.querySelectorAll('[data-goto]').forEach(el=>{
  el.addEventListener('click', ()=>goto(el.dataset.goto));
});
document.getElementById('startBtn').addEventListener('click', ()=>goto('learn'));

function rotateMotivation(){
  document.getElementById('homeMotivate').textContent = '"' + MOTIVATIONS[Math.floor(Math.random()*MOTIVATIONS.length)] + '"';
}
setInterval(rotateMotivation, 7000);

/* =========================================================
