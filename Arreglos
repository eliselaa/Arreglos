      {q:'¿Qué es un arreglo?', opts:['Una variable que solo guarda un valor','Una estructura que almacena varios valores del mismo tipo bajo un mismo nombre','Un tipo de bucle','Una función de PSeInt'], correct:1},
      {q:'¿Desde qué número comienzan los índices en PSeInt?', opts:['0','1','-1','Depende del tamaño'], correct:1},
