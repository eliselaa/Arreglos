let examQuestions = [];
let examIndex = 0;
let examScore = 0;

function shuffleArray(arr){ return [...arr].sort(()=>Math.random()-0.5); }

document.getElementById('examStartBtn').addEventListener('click', startExam);
document.getElementById('examRetryBtn').addEventListener('click', startExam);

function startExam(){
  examQuestions = shuffleArray(examBank).slice(0,10);
  examIndex = 0;
  examScore = 0;
  document.getElementById('examStart').classList.add('hidden');
  document.getElementById('examResult').classList.add('hidden');
  document.getElementById('examRunning').classList.remove('hidden');
  renderExamQuestion();
}

function renderExamQuestion(){
  const q = examQuestions[examIndex];
  document.getElementById('examProgress').textContent = `Pregunta ${examIndex+1} de ${examQuestions.length}`;
  document.getElementById('examBar').style.width = `${(examIndex/examQuestions.length)*100}%`;
  const area = document.getElementById('examQArea');
  area.innerHTML = `
    <div class="exam-q">
      <div class="q-text" style="font-size:16px;">${q.q}</div>
      <div class="opts" id="examOpts">
        ${q.opts.map((o,oi)=>`<button class="opt-btn" data-oi="${oi}">${o}</button>`).join('')}
      </div>
    </div>`;
  document.getElementById('examOpts').querySelectorAll('.opt-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const oi = +btn.dataset.oi;
      document.getElementById('examOpts').querySelectorAll('.opt-btn').forEach(b=>b.disabled=true);
      if(oi===q.correct){
        btn.classList.add('correct');
        examScore++;
      } else {
        btn.classList.add('wrong');
        document.getElementById('examOpts').children[q.correct].classList.add('correct');
      }
      setTimeout(()=>{
        examIndex++;
        if(examIndex < examQuestions.length){ renderExamQuestion(); }
        else { finishExam(); }
      }, 900);
    });
  });
}

function finishExam(){
  document.getElementById('examRunning').classList.add('hidden');
  document.getElementById('examResult').classList.remove('hidden');
  const pct = Math.round((examScore/examQuestions.length)*100);
  document.getElementById('examPct').textContent = pct + '%';
  document.getElementById('examScoreText').textContent = `Obtuviste ${examScore} / ${examQuestions.length}`;
  const circle = document.getElementById('resultCircle');
  const circumference = 415;
  circle.style.strokeDashoffset = circumference - (circumference*pct/100);

  let levelLabel, rec;
  if(pct < 50){ levelLabel='Principiante'; rec='Te recomendamos volver a repasar declaración y recorridos.'; }
  else if(pct < 70){ levelLabel='Intermedio'; rec='Vas por buen camino. Refuerza operaciones como máximo, promedio y conteo.'; }
  else if(pct < 90){ levelLabel='Avanzado'; rec='¡Muy bien! Sigue practicando búsqueda y recorridos inversos para perfeccionar.'; }
  else { levelLabel='Experto en Arreglos'; rec='¡Excelente! Dominas muy bien los fundamentos de arreglos.'; }
  document.getElementById('examLevelText').textContent = 'Nivel: ' + levelLabel;
  document.getElementById('examRecText').textContent = rec;
  state.examBadge = levelLabel;
  addXp(examScore * 8);
  renderHeader();
}

