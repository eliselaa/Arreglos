};
const XP_PER_LEVEL = 500;
const TOTAL_EXERCISES = 8;

const MOTIVATIONS = [
  "¡Cada línea de código que entiendes te acerca a dominar la programación!",
  "Equivocarse también es programar: analiza, corrige y vuelve a intentarlo.",
  "¡Vas avanzando! No necesitas entender todo a la primera.",
