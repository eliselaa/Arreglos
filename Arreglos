<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Arreglos en PSeInt · Entrenamiento</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{
  --purple:#7C3AED;
  --purple-dark:#5B21B6;
  --blue:#2563EB;
  --pink:#EC4899;
  --cyan:#06B6D4;
  --yellow:#FBBF24;
  --bg-0:#100A24;
  --bg-1:#170F35;
  --card:#1E1444;
  --card-2:#241a52;
  --ink:#F4F1FF;
  --ink-dim:#B9AEDD;
  --ink-faint:#8579b3;
  --green:#22C55E;
  --red:#F43F5E;
  --radius:22px;
  --radius-sm:14px;
  --shadow: 0 20px 45px -20px rgba(0,0,0,.55);
  --mono:'JetBrains Mono', monospace;
  --head:'Space Grotesk', sans-serif;
  --body:'Inter', sans-serif;
}
*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  margin:0;
  font-family:var(--body);
  color:var(--ink);
  background:
    radial-gradient(1100px 550px at 85% -10%, rgba(124,58,237,.35), transparent 60%),
    radial-gradient(900px 500px at -10% 10%, rgba(6,182,212,.22), transparent 55%),
    radial-gradient(700px 500px at 50% 120%, rgba(236,72,153,.18), transparent 60%),
    var(--bg-0);
  min-height:100vh;
  -webkit-font-smoothing:antialiased;
}
h1,h2,h3,h4{font-family:var(--head); margin:0; letter-spacing:-.01em;}
p{line-height:1.6; color:var(--ink-dim); margin:0 0 12px;}
code, .code{font-family:var(--mono);}
.hidden{display:none !important;}
button{font-family:var(--body); cursor:pointer;}
::selection{background:var(--pink); color:#fff;}
@media (prefers-reduced-motion: reduce){*{animation-duration:.001ms !important; transition-duration:.001ms !important;}}

/* ---------- App shell ---------- */
.app{max-width:1100px; margin:0 auto; padding:0 18px 90px;}
.topbar{
  position:sticky; top:0; z-index:50;
  backdrop-filter:blur(14px);
  background:rgba(16,10,36,.78);
  border-bottom:1px solid rgba(255,255,255,.08);
}
.topbar-inner{max-width:1100px; margin:0 auto; padding:14px 18px; display:flex; align-items:center; justify-content:space-between; gap:14px;}
.brand{display:flex; align-items:center; gap:10px;}
.brand-mark{
  width:38px; height:38px; border-radius:11px; flex:none;
  background:linear-gradient(135deg,var(--purple),var(--pink));
  display:flex; align-items:center; justify-content:center; font-size:19px;
  box-shadow:0 6px 16px -4px rgba(124,58,237,.6);
}
.brand-text{font-family:var(--head); font-weight:700; font-size:16px; line-height:1.1;}
.brand-text span{display:block; font-family:var(--body); font-weight:500; font-size:11.5px; color:var(--ink-faint);}
.xp-pill{
  display:flex; align-items:center; gap:8px;
  background:var(--card); border:1px solid rgba(255,255,255,.08);
  padding:7px 14px 7px 8px; border-radius:100px; font-size:13px; font-weight:600;
}
.xp-pill .lvl-badge{
  width:26px;height:26px;border-radius:50%;
  background:linear-gradient(135deg,var(--yellow),var(--pink));
  display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;color:#2b1240;
}
nav.mainnav{
  display:flex; gap:6px; overflow-x:auto; padding:10px 18px 12px;
  max-width:1100px; margin:0 auto; scrollbar-width:none;
}
nav.mainnav::-webkit-scrollbar{display:none;}
nav.mainnav button{
  flex:none; border:none; background:transparent; color:var(--ink-faint);
  font-weight:600; font-size:13.5px; padding:8px 14px; border-radius:100px;
  transition:background .18s, color .18s;
  display:flex; align-items:center; gap:6px;
}
nav.mainnav button.active{background:linear-gradient(135deg,var(--purple),var(--blue)); color:#fff;}
nav.mainnav button:not(.active):hover{background:rgba(255,255,255,.06); color:var(--ink);}

section.view{padding-top:26px; animation:fadein .35s ease;}
@keyframes fadein{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);}}

/* ---------- Reusable ---------- */
.card{
  background:linear-gradient(180deg, var(--card), var(--card-2));
  border:1px solid rgba(255,255,255,.07);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  padding:22px;
}
.btn{
  border:none; border-radius:100px; padding:13px 22px; font-weight:700; font-size:14.5px;
  color:#fff; background:linear-gradient(135deg,var(--purple),var(--pink));
  box-shadow:0 10px 24px -10px rgba(236,72,153,.55);
  transition:transform .15s ease, box-shadow .15s ease;
}
.btn:hover{transform:translateY(-2px); box-shadow:0 14px 28px -10px rgba(236,72,153,.65);}
.btn:active{transform:translateY(0);}
.btn.secondary{background:var(--card-2); box-shadow:none; border:1px solid rgba(255,255,255,.12); color:var(--ink);}
.btn.ghost{background:transparent; border:1px solid rgba(255,255,255,.15); color:var(--ink-dim); box-shadow:none;}
.btn.small{padding:8px 15px; font-size:13px;}
.btn:disabled{opacity:.4; cursor:not-allowed; transform:none; box-shadow:none;}
.pbar-track{height:10px; border-radius:100px; background:rgba(255,255,255,.08); overflow:hidden;}
.pbar-fill{height:100%; border-radius:100px; background:linear-gradient(90deg,var(--cyan),var(--purple),var(--pink)); transition:width .5s cubic-bezier(.22,1,.36,1);}
.tag{display:inline-flex; align-items:center; gap:5px; font-size:12px; font-weight:700; padding:4px 10px; border-radius:100px; background:rgba(255,255,255,.08); color:var(--ink-dim);}
.tag.g{background:rgba(34,197,94,.16); color:#6ee7a0;}
.tag.y{background:rgba(251,191,36,.16); color:#fcd34d;}
.tag.r{background:rgba(244,63,94,.16); color:#fca5b5;}
.grid{display:grid; gap:16px;}
.grid.cols-3{grid-template-columns:repeat(3,1fr);}
.grid.cols-2{grid-template-columns:repeat(2,1fr);}
@media(max-width:760px){.grid.cols-3, .grid.cols-2{grid-template-columns:1fr;}}
.codeblock{
  background:#0B0620; border:1px solid rgba(255,255,255,.08); border-radius:var(--radius-sm);
  padding:16px 18px; font-family:var(--mono); font-size:13.5px; line-height:1.75; color:#c9c0f5;
  overflow-x:auto; white-space:pre;
}
.codeblock .kw{color:#67e8f9;}
.codeblock .idx{color:var(--pink); font-weight:700;}
input.blank{
  font-family:var(--mono); font-size:13.5px; width:56px; text-align:center;
  background:#0B0620; border:2px solid var(--purple); border-radius:8px; color:#fff; padding:4px 6px; margin:0 3px;
}
input.blank.wide{width:130px;}
input.blank:focus{outline:none; border-color:var(--cyan);}
.feedback{
  margin-top:12px; padding:13px 16px; border-radius:var(--radius-sm); font-size:14px; font-weight:600;
  display:none; align-items:flex-start; gap:10px;
}
.feedback.show{display:flex;}
.feedback.ok{background:rgba(34,197,94,.14); color:#8fefb1; border:1px solid rgba(34,197,94,.35);}
.feedback.bad{background:rgba(244,63,94,.14); color:#ffb1c0; border:1px solid rgba(244,63,94,.35);}
.feedback p{color:inherit; margin:0;}
.hint-box{margin-top:10px; font-size:13px; color:var(--yellow); display:none;}
.hint-box.show{display:block;}
.toast{
  position:fixed; bottom:22px; left:50%; transform:translateX(-50%) translateY(20px);
  background:linear-gradient(135deg,var(--purple),var(--pink)); color:#fff; font-weight:700; font-size:13.5px;
  padding:13px 22px; border-radius:100px; box-shadow:0 14px 30px -8px rgba(0,0,0,.5);
  opacity:0; pointer-events:none; transition:all .35s cubic-bezier(.22,1,.36,1); z-index:200; white-space:nowrap;
}
.toast.show{opacity:1; transform:translateX(-50%) translateY(0);}

/* ---------- Home ---------- */
.hero{
  border-radius:28px; padding:38px 30px; position:relative; overflow:hidden;
  background:linear-gradient(135deg, #2a1665 0%, #4c1d95 45%, #7c1d6a 100%);
  box-shadow:var(--shadow);
}
.hero::after{
  content:""; position:absolute; inset:0;
  background:radial-gradient(400px 250px at 90% 10%, rgba(255,255,255,.14), transparent 60%);
}
.hero h1{font-size:clamp(26px,4vw,36px); position:relative; margin-bottom:10px;}
.hero p.lead{position:relative; color:#e4defc; font-size:15.5px; max-width:60ch;}
.hero-stats{display:flex; gap:22px; margin:22px 0 26px; flex-wrap:wrap; position:relative;}
.hero-stat b{display:block; font-family:var(--head); font-size:24px;}
.hero-stat span{font-size:12px; color:#c9bff5;}
.motivate{
  margin-top:22px; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.15);
  border-radius:var(--radius-sm); padding:13px 16px; font-size:13.5px; font-style:italic; color:#f1ecff; position:relative;
}
.section-title{display:flex; align-items:center; gap:10px; margin:34px 0 16px;}
.section-title h2{font-size:20px;}
.section-title .dot{width:9px; height:9px; border-radius:50%; background:linear-gradient(135deg,var(--cyan),var(--purple));}

/* ---------- Aprende ---------- */
.module{margin-bottom:16px; overflow:hidden;}
.module-head{display:flex; align-items:center; justify-content:space-between; cursor:pointer; gap:14px;}
.module-head h3{font-size:16.5px;}
.module-num{
  width:34px; height:34px; border-radius:10px; flex:none; display:flex; align-items:center; justify-content:center;
  background:linear-gradient(135deg,var(--blue),var(--cyan)); font-weight:800; font-size:14px;
}
.module-head-left{display:flex; align-items:center; gap:12px;}
.chev{transition:transform .25s ease; color:var(--ink-faint); font-size:18px;}
.module.open .chev{transform:rotate(180deg);}
.module-body{max-height:0; overflow:hidden; transition:max-height .35s ease;}
.module.open .module-body{max-height:6000px;}
.module-body-inner{padding-top:18px;}
.arr-demo{display:flex; gap:8px; margin:16px 0; flex-wrap:wrap;}
.arr-cell{
  width:56px; text-align:center; border-radius:10px; overflow:hidden; border:2px solid rgba(255,255,255,.12);
  background:#0B0620; cursor:pointer; transition:border-color .15s, transform .15s;
}
.arr-cell:hover{transform:translateY(-3px);}
.arr-cell.active{border-color:var(--pink); box-shadow:0 0 0 3px rgba(236,72,153,.25);}
.arr-cell .idx-lbl{font-size:11px; background:rgba(255,255,255,.06); color:var(--ink-faint); padding:3px 0;}
.arr-cell .val{font-family:var(--mono); font-weight:700; padding:9px 0; font-size:15px;}
.arr-readout{margin-top:10px; font-family:var(--mono); font-size:13.5px; color:var(--cyan); min-height:20px;}
.step-sim{margin-top:14px;}
.step-line{font-family:var(--mono); font-size:13.5px; padding:5px 0; color:var(--ink-faint); opacity:0; transform:translateX(-6px); transition:all .3s ease;}
.step-line.show{opacity:1; transform:translateX(0); color:#c9c0f5;}
.mini-quiz{margin-top:18px; padding-top:18px; border-top:1px dashed rgba(255,255,255,.12);}
.mini-quiz h4{font-size:14px; margin-bottom:10px; color:var(--ink-dim);}
.q-block{margin-bottom:16px;}
.q-text{font-weight:600; font-size:14.5px; margin-bottom:9px; color:var(--ink);}
.opts{display:flex; flex-direction:column; gap:8px;}
.opt-btn{
  text-align:left; background:rgba(255,255,255,.04); border:1.5px solid rgba(255,255,255,.1); color:var(--ink);
  border-radius:var(--radius-sm); padding:11px 14px; font-size:13.5px; transition:all .15s ease;
}
.opt-btn:hover{border-color:var(--purple); background:rgba(124,58,237,.12);}
.opt-btn.correct{border-color:var(--green); background:rgba(34,197,94,.16);}
.opt-btn.wrong{border-color:var(--red); background:rgba(244,63,94,.16);}
.opt-btn:disabled{cursor:default;}

/* ---------- Flashcards ---------- */
.fc-wrap{display:flex; flex-direction:column; align-items:center; gap:18px;}
.fc-progress-row{width:100%; max-width:520px; display:flex; align-items:center; gap:10px; font-size:12.5px; color:var(--ink-faint);}
.flashcard{
  width:100%; max-width:520px; height:250px; perspective:1200px; cursor:pointer;
}
.fc-inner{position:relative; width:100%; height:100%; transition:transform .5s cubic-bezier(.22,1,.36,1); transform-style:preserve-3d;}
.flashcard.flipped .fc-inner{transform:rotateY(180deg);}
.fc-face{
  position:absolute; inset:0; backface-visibility:hidden; border-radius:24px; padding:28px;
  display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center;
  box-shadow:var(--shadow); border:1px solid rgba(255,255,255,.1);
}
.fc-front{background:linear-gradient(150deg,var(--purple),var(--blue));}
.fc-back{background:linear-gradient(150deg,var(--pink),var(--purple-dark)); transform:rotateY(180deg);}
.fc-face .fc-label{font-size:11px; letter-spacing:.04em; color:rgba(255,255,255,.65); margin-bottom:12px; font-weight:700;}
.fc-face p{color:#fff; font-size:17px; font-weight:600; line-height:1.5; margin:0;}
.fc-controls{display:flex; gap:12px; width:100%; max-width:520px;}
.fc-controls button{flex:1;}
.btn.review{background:linear-gradient(135deg,#F59E0B,#EF4444);}
.btn.know{background:linear-gradient(135deg,#10B981,#06B6D4);}

/* ---------- Practica / niveles ---------- */
.level-group{margin-bottom:26px;}
.level-head{display:flex; align-items:center; gap:10px; margin-bottom:14px;}
.exercise-card{margin-bottom:16px; position:relative;}
.exercise-card.locked{opacity:.5;}
.exercise-card.locked::after{
  content:"🔒 Completa el nivel anterior para desbloquear"; position:absolute; inset:0; border-radius:var(--radius);
  display:flex; align-items:center; justify-content:center; background:rgba(16,10,36,.72); font-weight:700; font-size:13.5px;
  text-align:center; padding:20px;
}
.ex-head{display:flex; justify-content:space-between; align-items:flex-start; gap:12px; margin-bottom:10px;}
.ex-head h3{font-size:16.5px;}
.ex-body{font-size:14px;}
.blank-row{margin:12px 0;}
.hint-btn{font-size:12px; color:var(--yellow); background:none; border:none; text-decoration:underline; padding:0; margin-top:8px;}
.order-list{list-style:none; padding:0; margin:14px 0; display:flex; flex-direction:column; gap:8px;}
.order-item{
  background:#0B0620; border:1.5px solid rgba(255,255,255,.1); border-radius:10px; padding:10px 14px;
  font-family:var(--mono); font-size:13px; cursor:grab; display:flex; align-items:center; gap:10px;
}
.order-item .grip{color:var(--ink-faint);}
.order-item.dragging{opacity:.4;}
.classify-row{display:flex; flex-wrap:wrap; gap:10px; margin:14px 0;}
.classify-chip{
  background:#0B0620; border:1.5px solid rgba(255,255,255,.12); border-radius:12px; padding:10px 16px;
  font-family:var(--mono); font-weight:700;
}
.classify-btns{display:flex; gap:8px; margin-top:6px;}
.classify-btns button{font-size:11.5px; padding:5px 10px;}

/* ---------- Progreso ---------- */
.stat-card{text-align:center;}
.stat-card b{display:block; font-family:var(--head); font-size:28px; margin-bottom:2px;}
.stat-card span{font-size:12.5px; color:var(--ink-faint);}
.badge-row{display:flex; flex-wrap:wrap; gap:10px; margin-top:14px;}
.badge{
  padding:9px 15px; border-radius:100px; font-size:12.5px; font-weight:700; display:flex; align-items:center; gap:6px;
  background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1); color:var(--ink-faint);
}
.badge.earned{background:linear-gradient(135deg,rgba(251,191,36,.2),rgba(236,72,153,.2)); border-color:rgba(251,191,36,.4); color:var(--yellow);}

/* ---------- Desafío final ---------- */
#examStart .card{text-align:center;}
.exam-q{margin-bottom:22px;}
.exam-progress{font-size:12.5px; color:var(--ink-faint); margin-bottom:6px;}
.result-ring{width:150px; height:150px; margin:0 auto 18px; position:relative;}
.result-ring svg{transform:rotate(-90deg);}
.result-ring .pct{position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-family:var(--head); font-size:28px; font-weight:700;}

footer.credit{text-align:center; margin-top:60px; font-size:12px; color:var(--ink-faint);}
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-inner">
    <div class="brand">
      <div class="brand-mark">🧩</div>
      <div class="brand-text">Arreglos PSeInt<span>Entrenamiento interactivo</span></div>
    </div>
    <div class="xp-pill"><span class="lvl-badge" id="topLevel">1</span><span id="topXp">0 XP</span></div>
  </div>
  <nav class="mainnav" id="mainNav">
    <button data-view="home" class="active">🏠 Inicio</button>
    <button data-view="learn">📘 Aprende</button>
    <button data-view="flash">🃏 Flashcards</button>
    <button data-view="practice">💻 Práctica</button>
    <button data-view="exam">🏆 Desafíos</button>
    <button data-view="progress">📊 Progreso</button>
  </nav>
</div>

<div class="app">

  <!-- ================= HOME ================= -->
  <section class="view" id="view-home">
    <div class="hero">
      <h1>¡Bienvenido/a a tu entrenamiento de Arreglos en PSeInt! 👋</h1>
      <p class="lead">Aprenderás qué son los arreglos, cómo declararlos, recorrerlos y realizar operaciones como suma, promedio, búsqueda y conteo — practicando de verdad, no solo leyendo.</p>
      <div class="hero-stats">
        <div class="hero-stat"><b id="homeLevel">1</b><span>Nivel actual</span></div>
        <div class="hero-stat"><b id="homeXp">0 / 500</b><span>Experiencia (XP)</span></div>
        <div class="hero-stat"><b id="homeDone">0</b><span>Ejercicios completados</span></div>
        <div class="hero-stat"><b id="homePct">0%</b><span>Avance general</span></div>
      </div>
      <div class="pbar-track" style="max-width:420px;"><div class="pbar-fill" id="homeBar" style="width:0%"></div></div>
      <div style="margin-top:24px; position:relative;"><button class="btn" id="startBtn">Comenzar a estudiar →</button></div>
      <div class="motivate" id="homeMotivate">"Un algoritmo a la vez."</div>
    </div>

    <div class="section-title"><span class="dot"></span><h2>¿Por dónde empezar?</h2></div>
    <div class="grid cols-3">
      <div class="card"><h3 style="margin-bottom:8px;">📘 Aprende</h3><p>8 módulos con teoría, animaciones y mini quizzes.</p><button class="btn secondary small" data-goto="learn">Ir a Aprende</button></div>
      <div class="card"><h3 style="margin-bottom:8px;">🃏 Flashcards</h3><p>25 tarjetas para repasar los conceptos clave.</p><button class="btn secondary small" data-goto="flash">Ir a Flashcards</button></div>
      <div class="card"><h3 style="margin-bottom:8px;">💻 Práctica</h3><p>8 ejercicios progresivos por niveles.</p><button class="btn secondary small" data-goto="practice">Ir a Práctica</button></div>
    </div>
  </section>

  <!-- ================= APRENDE ================= -->
  <section class="view hidden" id="view-learn">
    <div class="section-title"><span class="dot"></span><h2>Aprende — Teoría en 8 módulos</h2></div>
    <div id="modulesWrap"></div>
  </section>

  <!-- ================= FLASHCARDS ================= -->
  <section class="view hidden" id="view-flash">
    <div class="section-title"><span class="dot"></span><h2>Flashcards</h2></div>
    <div class="fc-wrap">
      <div class="fc-progress-row">
        <span id="fcCounter">Tarjeta 1 / 25</span>
        <div class="pbar-track" style="flex:1;"><div class="pbar-fill" id="fcBar" style="width:4%"></div></div>
        <span id="fcReviewCount">0 por repasar</span>
      </div>
      <div class="flashcard" id="flashcard">
        <div class="fc-inner">
          <div class="fc-face fc-front"><div class="fc-label">PREGUNTA</div><p id="fcQ"></p></div>
          <div class="fc-face fc-back"><div class="fc-label">RESPUESTA</div><p id="fcA"></p></div>
        </div>
      </div>
      <p style="text-align:center; font-size:12.5px; color:var(--ink-faint);">Toca la tarjeta para girarla</p>
      <div class="fc-controls">
        <button class="btn review" id="fcReview">🔁 Necesito repasar</button>
        <button class="btn know" id="fcKnow">✅ Sé esto</button>
      </div>
    </div>
  </section>

  <!-- ================= PRACTICA ================= -->
  <section class="view hidden" id="view-practice">
    <div class="section-title"><span class="dot"></span><h2>Práctica — Ejercicios por nivel</h2></div>
    <div id="practiceWrap"></div>
  </section>

  <!-- ================= EXAM ================= -->
  <section class="view hidden" id="view-exam">
    <div class="section-title"><span class="dot"></span><h2>Desafío Final</h2></div>
    <div id="examStart">
      <div class="card">
        <h3 style="font-size:19px; margin-bottom:10px;">🏆 Pon a prueba todo lo aprendido</h3>
        <p>10 preguntas aleatorias que mezclan teoría, lectura de código, completar código, encontrar errores y predecir resultados.</p>
        <button class="btn" id="examStartBtn">Comenzar desafío</button>
      </div>
    </div>
    <div id="examRunning" class="hidden">
      <div class="card">
        <div class="exam-progress" id="examProgress"></div>
        <div class="pbar-track" style="margin-bottom:18px;"><div class="pbar-fill" id="examBar" style="width:0%"></div></div>
        <div id="examQArea"></div>
      </div>
    </div>
